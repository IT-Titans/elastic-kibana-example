# Demo defaults for a local, throwaway stack. Copy this file to .env before
# starting: cp .env.example .env
# None of these values is a secret. Do not reuse them outside this demo.

# Stack Config
STACK_VERSION=9.5.6
CLUSTER_NAME=docker-cluster
LICENSE=basic

# Elasticsearch Config
# Demo password of the built-in "elastic" user (at least 6 alphanumeric characters)
ELASTIC_PASSWORD=changeme
# Published on the loopback interface only; use ES_PORT=9200 to expose it to other hosts
ES_PORT=127.0.0.1:9200

# Kibana Config
# Demo password of the built-in "kibana_system" user (at least 6 alphanumeric characters)
KIBANA_PASSWORD=changeme
# Published on the loopback interface only; use KIBANA_PORT=5601 to expose it to other hosts
KIBANA_PORT=127.0.0.1:5601
# Demo key Kibana uses to encrypt sessions, saved objects and reports (32 characters or more)
ENCRYPTION_KEY=demoOnlyEncryptionKeyNotASecret0123456789
